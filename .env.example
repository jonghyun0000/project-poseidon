# Poseidon 환경변수 템플릿. 값을 채운 사본은 .env 로 저장한다 (.gitignore 대상 — 커밋 금지).
# 코드는 .env 를 직접 읽지 않는다. 셸에 올려서 쓴다:
#   set -a; source .env; set +a
#
# 키는 사용자 본인이 신청해 받은 것이다. 이 파일에도, 문서에도, 로그에도 값을 남기지 않는다.
# (2026-09-11 에 운영 로그에서 기상청 키 150건이 발견돼 가렸다 — HANDOFF.md 참조)

# 기상청 API허브 인증키 — 해양기상부이·파고부이 50개소. 없으면 KMA 수집을 조용히 건너뛴다.
POSEIDON_KMA_AUTHKEY=

# 바다누리(KHOA) 서비스키 — 2026-09-11 기준 미발급. 비워 둔다.
POSEIDON_KHOA_KEY=

# 데이터 루트를 프로젝트 밖으로 뺄 때만 쓴다. 기본값은 <프로젝트>/data (data.nosync 심볼릭 링크).
# POSEIDON_DATA_ROOT=
